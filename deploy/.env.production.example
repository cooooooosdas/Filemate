# 只填写域名，不带 https:// 或路径，例如 filemate.example.com。
FILEMATE_DOMAIN=filemate.example.com

# 生产环境必须显式限制 Host 与跨域来源。
FILEMATE_ENV=production
FILEMATE_ALLOWED_HOSTS=filemate.example.com,www.filemate.example.com,localhost,127.0.0.1
FILEMATE_CORS_ORIGINS=https://filemate.example.com,https://www.filemate.example.com
FILEMATE_IDENTITY_MODE=anonymous
# 可选：至少 32 字符。留空时服务会在持久数据卷生成 identity.secret。
FILEMATE_IDENTITY_SECRET=
FILEMATE_MAX_OPEN_TENANT_STORAGES=32

# 私有 Alpha 可使用共享访问凭据。若公开体验，必须提示用户不要上传
# 敏感资料，并在正式运营前补齐账户、租户隔离与配额控制。
FILEMATE_BASIC_USER=filemate
# 服务器命令：docker run -it --rm caddy:2-alpine caddy hash-password（随后交互输入强密码）
# 用单引号包住哈希，Compose 会按字面量保留其中的 $。
FILEMATE_BASIC_PASSWORD_HASH='$2a$14$replace_with_a_real_caddy_hash'

# 可选：AI 能力。密钥不得提交到 Git。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
