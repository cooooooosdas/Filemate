{
	admin off
}

(filemate_security_headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://v1.hitokoto.cn; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

{$FILEMATE_DOMAIN} {
	@assets path /assets/*
	@vision_assets path /interview-vision/*
	@uncached not path /assets/* /interview-vision/*
	@oversized expression `{header.Content-Length} != "" && int({header.Content-Length}) > 33554432`
	@api_docs path /docs* /openapi.json
	@api_only path /api/* /process /sessions /sessions/* /ai/* /settings /settings/* /knowledge/* /quiz/* /wrongbook/* /interview/* /interviews /interviews/* /analytics/* /review/* /study-plans /study-plans/* /evaluation/* /goals/* /trust/* /agents/*
	@api {
		path /knowledge /wrongbook /interview /goals /trust
		not header Accept text/html*
	}
	# BEGIN GENERATED SPA ROUTES
	@spa path / /ai-tools /career /classification /digital-human /goals /growth /history /import /interview /interview-bank /knowledge /knowledge-graph /login /naming /programming /recover /register /resume /schedule /semester /skills /study-plan /today /trial-feedback /trust /wrongbook
	# END GENERATED SPA ROUTES
	@robots path /robots.txt
	@sitemap path /sitemap.xml

	route {
		import filemate_security_headers
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @vision_assets Cache-Control "no-cache"
		header @uncached Cache-Control "no-store"
		header @robots Content-Type "text/plain; charset=utf-8"
		header @sitemap Content-Type "application/xml; charset=utf-8"
		encode zstd gzip
		basic_auth {
			{$FILEMATE_BASIC_USER} {$FILEMATE_BASIC_PASSWORD_HASH}
		}
		header @oversized Content-Type "application/json; charset=utf-8"
		respond @oversized `{"success":false,"data":null,"error":"请求体不能超过32 MiB"}` 413
		request_body {
			max_size 32MiB
		}
		handle /internal/* {
			respond 404
		}
		handle @api_docs {
			reverse_proxy api:8001
		}
		handle @api_only {
			reverse_proxy api:8001
		}
		handle @api {
			reverse_proxy api:8001
		}
		handle @spa {
			root * /srv
			try_files {path}/index.html /index.html
			file_server {
				precompressed br gzip
			}
		}
		handle {
			root * /srv
			file_server {
				precompressed br gzip
			}
		}
	}
	handle_errors 404 {
		import filemate_security_headers
		root * /srv
		rewrite * /index.html
		file_server {
			status 404
		}
	}
}
